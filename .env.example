# ============================================
# LOCAL ENVIRONMENT TEMPLATE
# ============================================
# This file contains EXAMPLE values only.
# DO NOT commit your actual API keys here.
# Use .env.local for development secrets (git-ignored)
# ============================================

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/leadflow_db
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# Server Configuration
SERVER_PORT=8080
APP_FRONTEND_URL=http://localhost:3000

# JWT & Security
JWT_SECRET=your-long-secret-key-min-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@leadflow.com

# Stripe Integration
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_ALERT_THRESHOLD=5

# OpenAI (AI Features)
# Get key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-mini

# SendGrid (Email Service)
# Get API key from https://sendgrid.com/
SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Monitoring
SYSTEM_ADMIN_EMAIL=admin@leadflow.com

# Cakto Webhook
CAKTO_WEBHOOK_SECRET=your-cakto-webhook-secret

# SendGrid Webhook
SENDGRID_WEBHOOK_VERIFY_SIGNATURE=false
SENDGRID_WEBHOOK_PUBLIC_KEY=

# Billing
BILLING_CHECKOUT_BASE_URL=https://yourdomain.com/checkout
