FROM postgres:15-alpine

# Instalar pgbackrest e utilidades
RUN apk add --no-cache \
    pgbackrest \
    curl \
    dumb-init

# Criar diretórios necessários
RUN mkdir -p /var/lib/pgbackrest && \
    chown -R postgres:postgres /var/lib/pgbackrest && \
    mkdir -p /etc/pgbackrest && \
    chown -R postgres:postgres /etc/pgbackrest

# Health check para Kubernetes
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-postgres}

# Expor porta PostgreSQL
EXPOSE 5432

# Usar dumb-init para manejo de sinais SIGTERM (graceful shutdown)
ENTRYPOINT ["dumb-init", "--", "docker-entrypoint.sh"]
CMD ["postgres"]